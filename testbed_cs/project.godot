; gdh's C# testbed. tests/test_csharp.py copies it and writes its .csproj for
; the Godot and .NET versions installed.

config_version=5

[application]

config/name="gdh C# testbed"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="GdhCsTestbed"
